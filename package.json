{
  "name": "citebrief",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "npx tsx src/lib/prompts.test.ts && npx tsx src/lib/extractor.test.ts && npx tsx src/lib/friday-tz.test.ts && npx tsx src/lib/s18-gaps.test.ts && npx tsx src/lib/prd-v22.test.ts && npx tsx src/lib/seo.test.ts && npx tsx src/lib/entitlements.test.ts && npx tsx src/lib/dodo-period.test.ts && npx tsx src/lib/launch-audit.test.ts && npx tsx src/lib/marketing-cta.test.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "auth:generate": "npx auth generate --config src/auth/cli.ts --output src/db/auth.schema.ts -y",
    "db:migrate:local": "wrangler d1 migrations apply citebrief --local",
    "db:migrate:remote": "wrangler d1 migrations apply citebrief --remote"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.4",
    "@dodopayments/core": "^0.3.15",
    "@dodopayments/hono": "^0.2.10",
    "@opennextjs/cloudflare": "1.20.6",
    "@radix-ui/react-slot": "^1.2.3",
    "better-auth": "1.7.4",
    "better-auth-cloudflare": "0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dodopayments": "^2.50.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "lucide-react": "^0.544.0",
    "next": "16.3.5",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "wrangler": "4.131.1"
  }
}
