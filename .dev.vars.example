NEXTJS_ENV=development

# Better Auth (single canonical origin; no BETTER_AUTH_TRUSTED_ORIGINS)
BETTER_AUTH_SECRET=replace-with-32-plus-random-chars
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (stub until live credentials)
GOOGLE_CLIENT_ID=stub-google-client-id
GOOGLE_CLIENT_SECRET=stub-google-client-secret

# Cloudflare Email Service From (not a secret). The EMAIL send_email binding is in wrangler.jsonc.
# Local next dev stubs when EMAIL is unbound. Production throws if EMAIL is missing.
CF_EMAIL_FROM=CiteBrief <auth@getcitebrief.com>

# Dodo Payments
DODO_PAYMENTS_API_KEY=stub
DODO_PAYMENTS_WEBHOOK_KEY=stub
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Optional product IDs from the Dodo dashboard (fallback: citebrief_{plan})
DODO_PRODUCT_STARTER=
DODO_PRODUCT_AGENCY=
DODO_PRODUCT_STUDIO=
DODO_PRODUCT_EXTRA_BRAND=
DODO_PRODUCT_EXTRA_RUN=

# Internal workers / cron (required outside development)
INTERNAL_PROCESS_SECRET=stub
CRON_SECRET=stub
INTERNAL_ADMIN_SECRET=stub

# Cloudflare AI Gateway (unset or stub = deterministic stub adapters)
CF_ACCOUNT_ID=
AI_GATEWAY_ID=
CF_AI_GATEWAY_TOKEN=

# AI Overviews uses Cloudflare Browser Rendering, not AI Gateway.
# Optional REST token when BROWSER binding is unavailable:
CF_API_TOKEN=
