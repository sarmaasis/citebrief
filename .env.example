# Used by `next dev` when you are not loading Wrangler bindings.
# Prefer `.dev.vars` (copy from `.dev.vars.example`) for OpenNext local bindings.

BETTER_AUTH_SECRET=replace-with-32-plus-random-chars
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=stub-google-client-id
GOOGLE_CLIENT_SECRET=stub-google-client-secret
# Cloudflare Email Service: Workers bind EMAIL via wrangler.jsonc send_email.
# next dev has no binding and stubs. Production without EMAIL.send fails closed.
# CF_EMAIL_FROM=CiteBrief <auth@getcitebrief.com>
DODO_PAYMENTS_API_KEY=stub
DODO_PAYMENTS_WEBHOOK_KEY=stub
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_STARTER=
DODO_PRODUCT_AGENCY=
DODO_PRODUCT_STUDIO=
DODO_PRODUCT_EXTRA_BRAND=
DODO_PRODUCT_EXTRA_RUN=
INTERNAL_PROCESS_SECRET=stub
CRON_SECRET=stub
INTERNAL_ADMIN_SECRET=stub

# Cloudflare AI Gateway (unset or stub = deterministic stub adapters)
CF_ACCOUNT_ID=
AI_GATEWAY_ID=
CF_AI_GATEWAY_TOKEN=

# AI Overviews uses Cloudflare Browser Rendering, not AI Gateway.
# Optional REST token when BROWSER binding is unavailable:
CF_API_TOKEN=
