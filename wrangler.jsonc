{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "citebrief",
  "main": "worker.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "citebrief"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "citebrief",
      "database_id": "aa4c730e-4f0c-453e-b0a9-dc6bbfaf3527",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "3db66fef31634f6ab26e25eb8fe3b8c7"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "citebrief-reports"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "RUNS_QUEUE",
        "queue": "citebrief-runs"
      }
    ],
    "consumers": [
      {
        "queue": "citebrief-runs",
        "max_batch_size": 5,
        "max_batch_timeout": 15,
        "max_retries": 3
      }
    ]
  },
  "browser": {
    "binding": "BROWSER"
  },
  "ai": {
    "binding": "AI"
  },
  // Cloudflare Email Service outbound binding. Onboard getcitebrief.com in the Email dashboard.
  // Do not set destination_address — invites, auth, and Friday sends go to arbitrary inboxes.
  // Local `next dev` has no binding and stubs. Wrangler/Workers runtime uses EMAIL.send().
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://getcitebrief.com",
    "DODO_PAYMENTS_ENVIRONMENT": "test_mode",
    "CF_EMAIL_FROM": "CiteBrief <auth@getcitebrief.com>"
  },
  "env": {
    // GitHub Actions staging (`development` branch) deploys `--env preview`
    // as Worker `citebrief-preview`. BETTER_AUTH_URL is workers.dev, not getcitebrief.com.
    // D1 is citebrief-staging (never the production database_id). Create it, then paste the id:
    //   npx wrangler d1 create citebrief-staging
    // Or set GitHub Actions variable STAGING_D1_DATABASE_ID (CI writes it before migrate).
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "citebrief-staging",
          "database_id": "551d69eb-8378-4fcd-b538-729d22b54097",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "BETTER_AUTH_URL": "https://citebrief.sarmaasis.workers.dev",
        "DODO_PAYMENTS_ENVIRONMENT": "test_mode",
        "CF_EMAIL_FROM": "CiteBrief <auth@getcitebrief.com>"
      }
    },
    "dev": {
      "vars": {
        "BETTER_AUTH_URL": "http://localhost:3000",
        "DODO_PAYMENTS_ENVIRONMENT": "test_mode",
        "CF_EMAIL_FROM": "CiteBrief <auth@getcitebrief.com>"
      }
    }
  },
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
