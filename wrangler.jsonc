{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "citebrief",
  "main": "worker.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "citebrief"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "citebrief",
      "database_id": "aa4c730e-4f0c-453e-b0a9-dc6bbfaf3527",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "3db66fef31634f6ab26e25eb8fe3b8c7"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "citebrief-reports"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "RUNS_QUEUE",
        "queue": "citebrief-runs"
      }
    ],
    "consumers": [
      {
        "queue": "citebrief-runs",
        "max_batch_size": 5,
        "max_batch_timeout": 15,
        "max_retries": 3
      }
    ]
  },
  "browser": {
    "binding": "BROWSER"
  },
  "vars": {
    "BETTER_AUTH_URL": "https://citebrief.sarmaasis.workers.dev",
    "DODO_PAYMENTS_ENVIRONMENT": "test_mode"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
